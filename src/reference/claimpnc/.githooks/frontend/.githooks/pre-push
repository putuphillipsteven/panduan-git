#!/bin/sh
# Q363 (amendemen 12 Okt 2026) — gerbang sebelum push: hanya npm run build.
#
# format:check, test, dan ambang coverage (.githooks/coverage-min) sementara
# dimatikan atas arahan developer; jalankan sendiri sebelum MR.
# Hook aktif otomatis lewat `npm install` (script "prepare").

set -eu

# Push yang hanya menghapus cabang tidak perlu diperiksa.
ada_isi=0
while read -r _ref_lokal sha_lokal _ref_remote _sha_remote; do
	case "$sha_lokal" in
	*[!0]*) ada_isi=1 ;;
	esac
done
[ "$ada_isi" -eq 0 ] && exit 0

cd "$(git rev-parse --show-toplevel)"
log=$(mktemp)
trap 'rm -f "$log"' EXIT

# Pesan dari developer (12 Okt 2026), ditampilkan apa adanya.
cat <<'PESAN'

--- VAR CHECKING ---

Mohon ditunggu 

Sementara coverage dimatikan ya ges, biar ga apa kali :).

PESAN

echo "pre-push: build"
npm run --silent build >"$log" 2>&1 || {
	tail -n 40 "$log" >&2
	echo "pre-push: GAGAL — npm run build" >&2
	echo "Silahkan diperbaiki dulu ya errornya :)" >&2
	exit 1
}

echo "BHAP!!! Lulus"
