#!/bin/sh
# Q363 (amendemen 12 Okt 2026) — gerbang sebelum push: hanya go build.
#
# gofmt, vet, test, dan ambang coverage (.githooks/coverage-min) sementara
# dimatikan atas arahan developer; jalankan sendiri sebelum MR.
# Aktifkan sekali per clone: git config core.hooksPath .githooks

set -eu

# Push yang hanya menghapus cabang tidak perlu diperiksa.
ada_isi=0
while read -r _ref_lokal sha_lokal _ref_remote _sha_remote; do
	case "$sha_lokal" in
	*[!0]*) ada_isi=1 ;;
	esac
done
[ "$ada_isi" -eq 0 ] && exit 0

cd "$(git rev-parse --show-toplevel)"
log=$(mktemp)
trap 'rm -f "$log"' EXIT

gagal() {
	echo "pre-push: GAGAL — $1" >&2
	echo "Silahkan diperbaiki dulu ya errornya :)" >&2
	exit 1
}

# Windows: antivirus/pengindeks kadang masih memegang berkas hasil build di folder
# temp Go, sehingga `go` gagal membersihkannya ("unlinkat ...: The directory is
# not empty") walau kodenya sendiri sukses. HANYA galat itu yang diulang (maks.
# 3x); kegagalan kompilasi tetap langsung menggagalkan push.
transien() { grep -q 'unlinkat .*The directory is not empty' "$1"; }

# Pesan dari developer (12 Okt 2026), ditampilkan apa adanya.
cat <<'PESAN'

--- VAR CHECKING ---

Mohon ditunggu 

Sementara coverage dimatikan ya ges, biar ga apa kali :).

PESAN

echo "pre-push: go build"
percobaan=0
while :; do
	if go build ./... >"$log" 2>&1; then
		break
	fi
	percobaan=$((percobaan + 1))
	if [ "$percobaan" -lt 3 ] && transien "$log"; then
		echo "pre-push: go build gagal sementara (folder temp terkunci), mengulang ($percobaan/3)"
		sleep 2
		continue
	fi
	cat "$log" >&2
	gagal "go build"
done

echo "BHAP!!! Lulus"
